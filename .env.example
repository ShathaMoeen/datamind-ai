APP_NAME=DataMind AI
APP_ENV=development
DEBUG=true
DATASET_UPLOAD_DIRECTORY=data/uploads
MAX_UPLOAD_SIZE_MB=10
DOCUMENT_UPLOAD_DIRECTORY=data/documents
MAX_DOCUMENT_UPLOAD_SIZE_MB=20
VECTOR_STORE_DIRECTORY=data/vector_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE_WORDS=250
RAG_CHUNK_OVERLAP_WORDS=40

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=600
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.4-nano

